# DirectorXO local development environment
# Copy to .env.local and fill values locally. Never commit secrets.

NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://directorxo:change-me@localhost:5432/directorxo

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Authentication
AUTH_SECRET=replace-with-local-secret

# Object storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email
SENDGRID_API_KEY=
EMAIL_FROM=

# Billing / payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Companies House
COMPANIES_HOUSE_API_KEY=

# Optional P1+ integrations
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
GOCARDLESS_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
