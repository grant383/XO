# DirectorXO local development environment
# Copy to .env.local and fill values locally. Never commit secrets.
# Values marked "local-only" match docker-compose.yml and must never be used outside a laptop.

NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# PostgreSQL — three least-privilege runtime roles (see docs/adr/0007-database-roles-and-rls.md)
# Runtime application role: NOBYPASSRLS, no table ownership, tenant context per transaction.
DATABASE_URL=postgresql://dxo_app:local-app-password@localhost:54329/directorxo
# Identity store role used only by Better Auth (users/sessions/credentials). No venture data access.
AUTH_DATABASE_URL=postgresql://dxo_auth:local-auth-password@localhost:54329/directorxo
# Schema owner used only by `pnpm db:migrate` / release step. Not available to web or worker at runtime.
MIGRATION_DATABASE_URL=postgresql://dxo_migrator:local-migrator-password@localhost:54329/directorxo

# Bootstrap only (`pnpm db:bootstrap`): superuser connection + passwords for the roles above.
ADMIN_DATABASE_URL=postgresql://dxo_admin:local-admin-password@localhost:54329/directorxo
DB_APP_PASSWORD=local-app-password
DB_AUTH_PASSWORD=local-auth-password
DB_MIGRATOR_PASSWORD=local-migrator-password

# Automated tests (database created by docker/postgres/init-test-db.sql)
TEST_ADMIN_DATABASE_URL=postgresql://dxo_admin:local-admin-password@localhost:54329/directorxo_test

# Redis / BullMQ (must run with maxmemory-policy=noeviction)
REDIS_URL=redis://localhost:63799

# Authentication (generate with: openssl rand -base64 32)
AUTH_SECRET=replace-with-local-secret
# Field-level encryption key for MFA/integration secrets (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=replace-with-local-key

# Object storage (local-only values match the SeaweedFS emulator)
S3_ENDPOINT=http://localhost:58333
S3_REGION=eu-west-2
S3_BUCKET=directorxo-local
S3_ACCESS_KEY_ID=local-access-key
S3_SECRET_ACCESS_KEY=local-secret-key
S3_FORCE_PATH_STYLE=true

# Email — SendGrid in staging/production; Mailpit SMTP locally (UI: http://localhost:58025)
EMAIL_PROVIDER=smtp
SMTP_URL=smtp://localhost:51025
SENDGRID_API_KEY=
EMAIL_FROM="DirectorXO <no-reply@localhost>"

# Billing / payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Companies House
COMPANIES_HOUSE_API_KEY=

# Observability (optional locally)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional P1+ integrations
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
GOCARDLESS_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
